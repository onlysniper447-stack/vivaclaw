# =============================================================================
# HETTNET — environment template
# Copy to `.env.local` (Next.js loads this automatically; never commit it).
# Server-only secrets MUST NOT use the NEXT_PUBLIC_ prefix.
# Indications are informational, not financial advice.
# =============================================================================

# --- Hyperliquid --------------------------------------------------------------
# Discovery uses mainnet snapshots (HyperEVM chain 999).
# Phase 3 execution: wallet connect is read-only. Connecting never signs.
# Plans encode mainnet addresses. Sign/send on mainnet stays off.
# HyperEVM lending/DEX testnet (998) deployments were not found.
# Do not put a private key here. Hettnet never holds keys.
HYPEREVM_RPC_URL="https://rpc.hyperliquid.xyz/evm"
HYPEREVM_TESTNET_RPC_URL="https://rpc.hyperliquid-testnet.xyz/evm"
HYPERCORE_INFO_URL="https://api.hyperliquid.xyz/info"
# Set to 1 to skip HyperEVM verify calls (build/CI).
HETTNET_SKIP_VERIFY="0"

# --- Cluster -----------------------------------------------------------------
# mainnet-beta | devnet | testnet
AGENT_CLUSTER="mainnet-beta"

# --- Solana RPC (Helius / QuickNode / Triton) --------------------------------
# Dedicated HTTPS endpoint. Public rpc.ankr / api.mainnet-beta.solana.com will
# rate-limit the agent under load. Include your provider API key in the URL.
SOLANA_RPC_URL="https://mainnet.helius-rpc.com/?api-key=REPLACE_ME"
SOLANA_WS_URL="wss://mainnet.helius-rpc.com/?api-key=REPLACE_ME"

# confirmed is the production default. Use finalized only for settlement audit.
SOLANA_COMMITMENT="confirmed"

# --- Agent signer (SERVER ONLY, Solana archive path) -------------------------
# Unused for Hyperliquid Phase 3. Leave empty. Connecting never signs.
# Base58-encoded 64-byte Solana secret key if the archived Solana console is run.
# NEVER prefix with NEXT_PUBLIC_. Rotate immediately if this value leaks.
AGENT_PRIVATE_KEY=""

# --- Jupiter Swap API v6 -----------------------------------------------------
# Free (rate-limited):  https://lite-api.jup.ag/swap/v1
# Paid (portal key):    https://api.jup.ag/swap/v1
# Keys: https://portal.jup.ag  — send as x-api-key when JUPITER_API_KEY is set.
JUPITER_API_URL="https://lite-api.jup.ag/swap/v1"
JUPITER_API_KEY=""

# Default route slippage for quote + swap (basis points). 50 = 0.50%.
JUPITER_SLIPPAGE_BPS="50"

# --- Pyth Network (Hermes price service) -------------------------------------
# Official client: @pythnetwork/hermes-client
# GET {PYTH_HERMES_URL}/v2/updates/price/latest
# Since 2026-08-26 Hermes requires a Pyth API key on every request.
# Header: Authorization: Bearer $PYTH_API_KEY
# Get a key (free signup): https://pythdata.app/signup
# Alternate upgraded base URL: https://pyth.dourolabs.app/hermes
PYTH_HERMES_URL="https://hermes.pyth.network"
PYTH_API_KEY=""
# Reject oracle prints older than this (milliseconds).
ORACLE_MAX_STALENESS_MS="15000"

# --- Risk guardrails ---------------------------------------------------------
# true  = scan + simulate only. No transactions are signed or submitted.
# false = live execution. Requires AGENT_PRIVATE_KEY and a funded wallet.
AGENT_DRY_RUN="true"

# Hard caps. All values are integers (basis points or native SOL).
MAX_SLIPPAGE_BPS="50"
MAX_LTV_BPS="6500"
MAX_POSITION_SOL="10"
MIN_NET_APY_BPS="150"
MAX_PRICE_IMPACT_BPS="80"

# Scan cadence for the yield sensor loop (milliseconds).
SCAN_INTERVAL_MS="15000"

# --- Yield arb + execution ---------------------------------------------------
# |APY_Meteora − APY_Kamino| trigger. 350 = 3.5%.
YIELD_DELTA_TRIGGER_BPS="350"
# USDC/USDT Pyth peg band. 50 = ±0.50%.
PEG_MAX_DEVIATION_BPS="50"
VOLATILITY_MAX_BPS="150"
# Jito tip attached to Jupiter v6 swaps (lamports). Send via JITO_RPC_URL when set.
JITO_TIP_LAMPORTS="200000"
JITO_RPC_URL=""
EXECUTION_COOLDOWN_MS="60000"

# --- Live dashboard WebSocket feed -------------------------------------------
# Bound by `npm run engine:feed`. The browser connects to this port.
NEXT_PUBLIC_WS_PORT="8787"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CLUSTER="mainnet-beta"
